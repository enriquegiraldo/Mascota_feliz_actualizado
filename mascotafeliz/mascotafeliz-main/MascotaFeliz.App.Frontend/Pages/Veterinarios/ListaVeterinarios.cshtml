@page
@model MascotaFeliz.App.Frontend.Pages.ListaVeterinariosModel
@{
    ViewData["Title"] = "Veterinarios";
}

<div class="mf-encabezado">
    <div>
        <h1>Veterinarios</h1>
        <p class="mf-muted">Personal veterinario de la clínica.</p>
    </div>
    <div class="mf-acciones">
        <a class="btn btn-primary mf-btn-tactil" asp-page="./EditarVeterinario">+ Nuevo veterinario</a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="mf-aviso" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@TempData["Error"]</span>
    </div>
}

<form method="get" class="mf-buscador" role="search">
    <div class="mf-input-busqueda">
        <span class="mf-ico-lupa" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
        <input type="search" name="Q" value="@Model.Q" placeholder="Buscar por nombre o apellido…" aria-label="Buscar veterinarios" />
    </div>
    <button type="submit" class="btn btn-outline-primary mf-btn-tactil">Buscar</button>
    @if (!string.IsNullOrWhiteSpace(Model.Q))
    {
        <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaVeterinarios">Limpiar</a>
    }
</form>

@if (!Model.listaVeterinarios.Any())
{
    <div class="mf-vacio">
        <svg class="mf-vacio-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <p>No hay veterinarios que coincidan con la búsqueda.</p>
        <a class="btn btn-primary mf-btn-tactil" asp-page="./EditarVeterinario">Registrar el primer veterinario</a>
    </div>
}
else
{
    <div style="overflow-x:auto;">
    <table class="mf-tabla">
        <thead>
            <tr>
                <th>Nombre completo</th>
                <th>Tarjeta profesional</th>
                <th>Teléfono</th>
                <th><span class="mf-sr-only">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var veterinario in Model.listaVeterinarios)
        {
            <tr>
                <td>
                    <strong>@veterinario.Nombres @veterinario.Apellidos</strong>
                    <div class="mf-muted" style="font-size:.8rem;">#@veterinario.Id</div>
                </td>
                <td><span class="mf-badge">@veterinario.TarjetaProfesional</span></td>
                <td>@veterinario.Telefono</td>
                <td>
                    <div class="mf-tabla-acciones">
                        <a class="btn btn-ghost mf-btn-tactil" asp-page="./DetallesVeterinarios" asp-route-veterinarioId="@veterinario.Id">Detalle</a>
                        @if (User.IsInRole("Admin")) {
<a class="btn btn-outline-primary mf-btn-tactil" asp-page="./EditarVeterinario" asp-route-veterinarioId="@veterinario.Id">Editar</a>
}
                        @if (User.IsInRole("Admin")) {
<form method="post" asp-page-handler="Eliminar" asp-route-veterinarioId="@veterinario.Id"
                              data-mf-borrar="true" data-nombre="el veterinario @veterinario.Nombres @veterinario.Apellidos">
                            <button type="submit" class="btn btn-danger mf-btn-tactil" aria-label="Eliminar veterinario">Eliminar</button>
                        </form>
}
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>

    <nav class="mf-paginacion" aria-label="Paginación" style="justify-content:space-between;">
        <span class="mf-muted" style="border:none;background:none;">@Model.Total registro(s) · pág. @Model.Pagina de @Model.TotalPaginas</span>
        <span style="display:flex;gap:.35rem;">
            @if (Model.Pagina > 1)
            {
                <a asp-page="./ListaVeterinarios" asp-route-Q="@Model.Q" asp-route-Pagina="@(Model.Pagina - 1)">‹ Anterior</a>
            }
            else
            {
                <span class="mf-deshab">‹ Anterior</span>
            }
            @if (Model.Pagina < Model.TotalPaginas)
            {
                <a asp-page="./ListaVeterinarios" asp-route-Q="@Model.Q" asp-route-Pagina="@(Model.Pagina + 1)">Siguiente ›</a>
            }
            else
            {
                <span class="mf-deshab">Siguiente ›</span>
            }
        </span>
    </nav>
}
