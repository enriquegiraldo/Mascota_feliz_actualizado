@page
@model MascotaFeliz.App.Frontend.Pages.Publico.PortadaModel
@{
    ViewData["Title"] = "Clínica veterinaria en Bogotá";
    ViewData["MetaDescripcion"] = "Clínica veterinaria Mascota Feliz en Bogotá. Atención profesional, citas online, vacunación, cirugía y cuidado integral para tu mascota.";
}

<!-- Hero -->
<section class="mf-hero-publico">
    <div class="mf-contenedor mf-hero-publico-contenido">
        <div class="mf-hero-publico-texto">
            <span class="mf-badge mf-badge--ambar">Clínica veterinaria en Bogotá</span>
            <h1 class="mf-hero-titulo">Tu mascota<br /><span class="mf-hero-destacado">en buenas manos</span></h1>
            <p class="mf-hero-subtitulo">Atención profesional, citas online y cuidado integral. Porque tu mascota merece lo mejor.</p>
            <div class="mf-hero-cta">
                <a asp-page="/Publico/Agendar" class="btn btn-primary btn-lg mf-btn-tactil">Agendar cita</a>
                <a href="#servicios" class="btn btn-ghost btn-lg mf-btn-tactil">Ver servicios</a>
            </div>
            <div class="mf-hero-stats">
                <div class="mf-hero-stat"><strong>@Model.TotalMascotas</strong><span>mascotas atendidas</span></div>
                <div class="mf-hero-stat"><strong>@Model.TotalVeterinarios</strong><span>veterinarios</span></div>
                <div class="mf-hero-stat"><strong>8+</strong><span>años de experiencia</span></div>
            </div>
        </div>
        <div class="mf-hero-publico-visual" aria-hidden="true">
            <div class="mf-hero-circulo">
                <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 64 64">
                    <defs><linearGradient id="hg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0d7a5f"/><stop offset="1" stop-color="#095c47"/></linearGradient></defs>
                    <rect width="64" height="64" rx="16" fill="url(#hg)"/>
                    <g fill="none" stroke="#ffffff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 18 v8 a10 10 0 0 0 20 0 v-8"/><path d="M32 36 v6 a8 8 0 0 0 8 8"/><circle cx="22" cy="16" r="3" fill="#ffffff" stroke="none"/><circle cx="42" cy="16" r="3" fill="#ffffff" stroke="none"/><circle cx="40" cy="50" r="4" fill="#ffffff" stroke="none"/></g>
                    <path d="M50 12 c-1.2-1.2-3.1-1.2-4.3 0 l-.7.7-.7-.7 c-1.2-1.2-3.1-1.2-4.3 0 -1.2 1.2-1.2 3.1 0 4.3 l5 5 5-5 c1.2-1.2 1.2-3.1 0-4.3 z" fill="#f59e0b"/>
                </svg>
            </div>
        </div>
    </div>
</section>

<!-- Servicios -->
<section id="servicios" class="mf-seccion-publico">
    <div class="mf-contenedor">
        <div style="text-align:center;margin-bottom:2.5rem;">
            <h2>Nuestros servicios</h2>
            <p class="mf-muted">Cuidado integral para cada etapa de la vida de tu mascota.</p>
        </div>
        <div class="mf-servicios-grid">
            <div class="mf-servicio-card">
                <div class="mf-servicio-ico" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 8-8"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
                <h3>Consultas y vacunación</h3>
                <p>Controles periódicos, esquemas de vacunación y desparasitación.</p>
            </div>
            <div class="mf-servicio-card">
                <div class="mf-servicio-ico" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg></div>
                <h3>Cirugía y procedimientos</h3>
                <p>Esterilización, cirugía general y procedimientos especiales con monitoreo.</p>
            </div>
            <div class="mf-servicio-card">
                <div class="mf-servicio-ico" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
                <h3>Citas online</h3>
                <p>Agenda tu cita desde casa, sin llamadas. Confirmación por WhatsApp.</p>
            </div>
            <div class="mf-servicio-card">
                <div class="mf-servicio-ico" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg></div>
                <h3>Historia clínica digital</h3>
                <p>Registro completo de cada visita: signos vitales, peso, recomendaciones.</p>
            </div>
            <div class="mf-servicio-card">
                <div class="mf-servicio-ico" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
                <h3>Urgencias</h3>
                <p>Atención de emergencias durante horario de consulta. Llámanos antes de venir.</p>
            </div>
            <div class="mf-servicio-card">
                <div class="mf-servicio-ico" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
                <h3>Recordatorios de vacunas</h3>
                <p>Te avisamos cuándo le toca el refuerzo. Nunca más se te olvidará una vacuna.</p>
            </div>
        </div>
    </div>
</section>

<!-- Equipo -->
<section id="equipo" class="mf-seccion-publico mf-seccion-equipo">
    <div class="mf-contenedor">
        <div style="text-align:center;margin-bottom:2.5rem;">
            <h2>Nuestro equipo</h2>
            <p class="mf-muted">Profesionales dedicados al bienestar de tu mascota.</p>
        </div>
        <div class="mf-equipo-grid">
            @Html.Raw(Model.HtmlEquipo)
        </div>
    </div>
</section>

<!-- CTA final -->
<section class="mf-seccion-publico">
    <div class="mf-contenedor">
        <div class="mf-cta-final">
            <h2>¿Listo para agendar la cita de tu mascota?</h2>
            <p>Solicítala online y te confirmamos por WhatsApp. Sin filas, sin esperas.</p>
            <a asp-page="/Publico/Agendar" class="btn btn-primary btn-lg mf-btn-tactil">Agendar cita ahora</a>
        </div>
    </div>
</section>
