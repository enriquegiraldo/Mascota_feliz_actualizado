@page
@model MascotaFeliz.App.Frontend.Pages.DetallesDuenosModel
@{
    ViewData["Title"] = "Detalles del dueño";
}

<nav aria-label="Migas de pan" class="mf-migas">
    <a asp-page="/Duenos/ListaDuenos">Dueños</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">@Model.dueno.Nombres @Model.dueno.Apellidos</span>
</nav>

<div class="mf-encabezado">
    <div>
        <span class="mf-badge mf-badge--terracota">Tutor</span>
        <h1 style="margin-top:.4rem;">@Model.dueno.Nombres @Model.dueno.Apellidos</h1>
        <p class="mf-muted">Información de contacto del responsable.</p>
    </div>
    <div class="mf-acciones">
        <a class="btn btn-outline-primary mf-btn-tactil" asp-page="./EditarDueno" asp-route-duenoId="@Model.dueno.Id">Editar</a>
        <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaDuenos">← Volver</a>
    </div>
</div>

<div class="mf-ficha">
    <div class="mf-ficha-titulo">
        <svg class="mf-ficha-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <h2 style="margin:0;">Datos de contacto</h2>
    </div>
    <dl>
        <div class="mf-fila"><dt>Nombre completo</dt><dd>@Model.dueno.Nombres @Model.dueno.Apellidos</dd></div>
        <div class="mf-fila"><dt>Teléfono</dt><dd>@(string.IsNullOrWhiteSpace(Model.dueno.Telefono) ? "—" : Model.dueno.Telefono)</dd></div>
        <div class="mf-fila"><dt>Correo</dt><dd>@(string.IsNullOrWhiteSpace(Model.dueno.Correo) ? "—" : Model.dueno.Correo)</dd></div>
        <div class="mf-fila"><dt>Dirección</dt><dd>@(string.IsNullOrWhiteSpace(Model.dueno.Direccion) ? "—" : Model.dueno.Direccion)</dd></div>
        <div class="mf-fila"><dt>Identificador</dt><dd>#@Model.dueno.Id</dd></div>
    </dl>
</div>

<div class="mf-ficha">
    <div class="mf-ficha-titulo">
        <svg class="mf-ficha-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="4" cy="8" r="2"/><circle cx="18" cy="16" r="2"/><circle cx="4" cy="16" r="2"/><path d="M9 10c0 3 2 5 3 7 1-2 3-4 3-7"/></svg>
        <h2 style="margin:0;">Mascotas (@Model.mascotas.Count())</h2>
    </div>

    @if (!Model.mascotas.Any())
    {
        <div class="mf-vacio" style="padding:1.5rem 1rem;">
            <p>Este dueño aún no tiene mascotas registradas.</p>
            <a class="btn btn-primary mf-btn-tactil" asp-page="/Mascotas/EditarMascota">Registrar una mascota</a>
        </div>
    }
    else
    {
        <div class="mf-lista-mascotas">
        @foreach (var m in Model.mascotas)
        {
            <a class="mf-card mf-card--clickable mf-tarjeta-mascota" asp-page="/Mascotas/DetallesMascotas" asp-route-mascotaId="@m.Id">
                <span class="mf-tarjeta-mascota-avatar mf-avatar-@(m.Especie == "Gato" ? "gato" : "perro")" aria-hidden="true">
                    @if (m.Especie == "Gato")
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12 8C8 8 6 11 6 14v6h12v-6c0-3-2-6-6-6zM6 4l3 4-2 1-3-3zM18 4l2 2-3 3-2-1z"/></svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M4 10c0-3 2-5 5-5 1 0 2 1 3 1s2-1 3-1c3 0 5 2 5 5v3h-3v6H7v-6H4z"/></svg>
                    }
                </span>
                <span style="flex:1;min-width:0;">
                    <strong>@m.Nombre</strong>
                    <div class="mf-muted" style="font-size:.82rem;">@m.Especie · @m.Raza</div>
                </span>
                <span class="mf-badge" aria-hidden="true">Ver ›</span>
            </a>
        }
        </div>
    }
</div>
