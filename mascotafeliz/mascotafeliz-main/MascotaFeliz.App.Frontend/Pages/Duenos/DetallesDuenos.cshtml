@page
@model MascotaFeliz.App.Frontend.Pages.DetallesDuenosModel
@{
    ViewData["Title"] = "Detalles del dueño";
}

<nav aria-label="Migas de pan" class="mf-migas">
    <a asp-page="/Duenos/ListaDuenos">Dueños</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">@Model.dueno.Nombres @Model.dueno.Apellidos</span>
</nav>

<div class="mf-encabezado">
    <div>
        <span class="mf-badge mf-badge--terracota">Tutor</span>
        <h1 style="margin-top:.4rem;">@Model.dueno.Nombres @Model.dueno.Apellidos</h1>
        <p class="mf-muted">Información de contacto del responsable.</p>
    </div>
    <div class="mf-acciones">
        <a class="btn btn-outline-primary mf-btn-tactil" asp-page="./EditarDueno" asp-route-duenoId="@Model.dueno.Id">Editar</a>
        <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaDuenos">← Volver</a>
    </div>
</div>

<div class="mf-ficha">
    <div class="mf-ficha-titulo">
        <svg class="mf-ficha-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <h2 style="margin:0;">Datos de contacto</h2>
    </div>
    <dl>
        <div class="mf-fila"><dt>Nombre completo</dt><dd>@Model.dueno.Nombres @Model.dueno.Apellidos</dd></div>
        <div class="mf-fila"><dt>Teléfono</dt><dd>@(string.IsNullOrWhiteSpace(Model.dueno.Telefono) ? "—" : Model.dueno.Telefono)</dd></div>
        <div class="mf-fila"><dt>Correo</dt><dd>@(string.IsNullOrWhiteSpace(Model.dueno.Correo) ? "—" : Model.dueno.Correo)</dd></div>
        <div class="mf-fila"><dt>Dirección</dt><dd>@(string.IsNullOrWhiteSpace(Model.dueno.Direccion) ? "—" : Model.dueno.Direccion)</dd></div>
        <div class="mf-fila"><dt>Identificador</dt><dd>#@Model.dueno.Id</dd></div>
    </dl>
</div>

<div class="mf-ficha">
    <vc:tarjetas-mascotas mascotas="@Model.mascotas" titulo="Mascotas" />
</div>
