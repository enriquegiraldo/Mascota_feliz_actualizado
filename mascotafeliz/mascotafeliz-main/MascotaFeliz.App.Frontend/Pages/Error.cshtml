@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="mf-ficha" style="max-width:620px;margin:2rem auto;text-align:center;">
    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--mf-ambar-osc)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:1rem;" aria-hidden="true">
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
    <h1>Algo salió mal</h1>
    <p class="mf-muted">Ocurrió un error inesperado al procesar tu solicitud. Intenta de nuevo en unos minutos.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mf-avance"><small>Código de referencia: <code>@Model.RequestId</code></small></p>
    }
    <div style="margin-top:1.25rem;">
        <a asp-page="/Index" class="btn btn-primary mf-btn-tactil">Volver al inicio</a>
    </div>
</div>
