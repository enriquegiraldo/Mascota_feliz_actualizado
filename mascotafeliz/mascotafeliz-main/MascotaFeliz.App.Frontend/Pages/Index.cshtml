@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="mf-ficha mf-hero-mascota" style="background:linear-gradient(135deg,var(--mf-verde-claro2) 0%,var(--mf-arena) 100%);">
    <div class="mf-hero-mascota-contenido">
        <div style="flex:1 1 320px;">
            <span class="mf-badge mf-badge--ambar">Clínica veterinaria</span>
            <h1 style="margin-top:.5rem;">Bienvenido a Mascota Feliz</h1>
            <p class="mf-muted" style="font-size:1.05rem;">Gestiona mascotas, dueños y veterinarios, y consulta el historial clínico de cada paciente en un solo lugar.</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 64 64" aria-hidden="true" style="flex:0 0 auto;">
            <defs><linearGradient id="hg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0d7a5f"/><stop offset="1" stop-color="#095c47"/></linearGradient></defs>
            <rect width="64" height="64" rx="16" fill="url(#hg)"/>
            <g fill="none" stroke="#ffffff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 18 v8 a10 10 0 0 0 20 0 v-8"/>
                <path d="M32 36 v6 a8 8 0 0 0 8 8"/>
                <circle cx="22" cy="16" r="3" fill="#ffffff" stroke="none"/>
                <circle cx="42" cy="16" r="3" fill="#ffffff" stroke="none"/>
                <circle cx="40" cy="50" r="4" fill="#ffffff" stroke="none"/>
            </g>
            <path d="M50 12 c-1.2-1.2-3.1-1.2-4.3 0 l-.7.7-.7-.7 c-1.2-1.2-3.1-1.2-4.3 0 -1.2 1.2-1.2 3.1 0 4.3 l5 5 5-5 c1.2-1.2 1.2-3.1 0-4.3 z" fill="#f59e0b"/>
        </svg>
    </div>
</section>

<section aria-labelledby="resumen-titulo" style="margin-top:1.5rem;">
    <h2 id="resumen-titulo" style="font-size:1.15rem;margin-bottom:.75rem;">Resumen</h2>
    <div class="mf-inicio-grid">
        <article class="mf-card mf-card--clickable">
            <div class="mf-kpi">
                <span class="mf-kpi-ico" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 64 64" fill="currentColor"><ellipse cx="20" cy="22" rx="5" ry="6.5"/><ellipse cx="32" cy="18" rx="5" ry="7"/><ellipse cx="44" cy="22" rx="5" ry="6.5"/><ellipse cx="50" cy="33" rx="4.5" ry="5.5"/><ellipse cx="14" cy="33" rx="4.5" ry="5.5"/><path d="M32 32c-9 0-16 6-16 13 0 5 4 8 9 8 3 0 5-1 7-1s4 1 7 1c5 0 9-3 9-8 0-7-7-13-16-13z"/></svg>
                </span>
                <div>
                    <div class="mf-kpi-numero">@Model.TotalMascotas</div>
                    <div class="mf-muted" style="font-size:.85rem;">Mascotas</div>
                </div>
            </div>
            <a class="btn btn-primary mf-btn-tactil" style="margin-top:.75rem;width:100%;" asp-page="/Mascotas/ListaMascotas">Ver mascotas</a>
        </article>

        <article class="mf-card mf-card--clickable">
            <div class="mf-kpi">
                <span class="mf-kpi-ico mf-kpi-ico--ambar" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <div>
                    <div class="mf-kpi-numero">@Model.TotalDuenos</div>
                    <div class="mf-muted" style="font-size:.85rem;">Dueños</div>
                </div>
            </div>
            <a class="btn btn-outline-primary mf-btn-tactil" style="margin-top:.75rem;width:100%;" asp-page="/Duenos/ListaDuenos">Ver dueños</a>
        </article>

        <article class="mf-card mf-card--clickable">
            <div class="mf-kpi">
                <span class="mf-kpi-ico mf-kpi-ico--gris" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <div>
                    <div class="mf-kpi-numero">@Model.TotalVeterinarios</div>
                    <div class="mf-muted" style="font-size:.85rem;">Veterinarios</div>
                </div>
            </div>
            <a class="btn btn-outline-primary mf-btn-tactil" style="margin-top:.75rem;width:100%;" asp-page="/Veterinarios/ListaVeterinarios">Ver veterinarios</a>
        </article>

        <article class="mf-card mf-card--clickable">
            <div class="mf-kpi">
                <span class="mf-kpi-ico" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>
                <div>
                    <div class="mf-kpi-numero">@Model.TotalVisitas</div>
                    <div class="mf-muted" style="font-size:.85rem;">Visitas PyP</div>
                </div>
            </div>
            <a class="btn btn-outline-primary mf-btn-tactil" style="margin-top:.75rem;width:100%;" asp-page="/VisitasPyP/ListaVisitasPyP">Ver visitas</a>
        </article>
    </div>
</section>

@if (!string.IsNullOrEmpty(Model.DonutSvg))
{
    @Html.Raw($"<section aria-labelledby=\"dist-titulo\" class=\"mf-ficha\" style=\"margin-top:1.5rem;display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem;\"><div style=\"flex:0 0 auto;\"><h2 id=\"dist-titulo\" style=\"font-size:1.1rem;margin:0 0 .5rem;\">Distribución por especie</h2>{Model.DonutSvg}</div><ul class=\"mf-leyenda\" style=\"flex:1 1 200px;list-style:none;padding:0;margin:0;display:grid;gap:.4rem;\">{Model.LeyendaDonutHtml}</ul></section>")
}

@if (!string.IsNullOrEmpty(Model.RecordatoriosHtml))
{
    @Html.Raw(Model.RecordatoriosHtml)
}

<section aria-labelledby="accesos-titulo" style="margin-top:1.5rem;">
    <h2 id="accesos-titulo" style="font-size:1.15rem;margin-bottom:.75rem;">Accesos rápidos</h2>
    <div class="mf-tabla-acciones">
        <a class="btn btn-ghost mf-btn-tactil" asp-page="/Mascotas/EditarMascota">+ Nueva mascota</a>
        <a class="btn btn-ghost mf-btn-tactil" asp-page="/Duenos/EditarDueno">+ Nuevo dueño</a>
        <a class="btn btn-ghost mf-btn-tactil" asp-page="/Veterinarios/EditarVeterinario">+ Nuevo veterinario</a>
        <a class="btn btn-ghost mf-btn-tactil" asp-page="/VisitasPyP/EditarVisitaPyP">+ Nueva visita</a>
        <a class="btn btn-ghost mf-btn-tactil" asp-page="/Citas/EditarCita">+ Nueva cita</a>
        <a class="btn btn-ghost mf-btn-tactil" asp-page="/Historias/ListaHistorias">Historias clínicas</a>
    </div>
</section>
