@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="mf-ficha" style="background:linear-gradient(135deg,#e8f0ea 0%,#fbf7f0 100%);">
    <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1 1 320px;">
            <span class="mf-badge mf-badge--terracota">Clínica veterinaria</span>
            <h1 style="margin-top:.5rem;">Bienvenido a Mascota Feliz</h1>
            <p class="mf-muted" style="font-size:1.05rem;">Gestiona mascotas, dueños y veterinarios, y consulta el historial clínico de cada paciente en un solo lugar.</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 64 64" aria-hidden="true" style="flex:0 0 auto;">
            <rect width="64" height="64" rx="16" fill="#4a7c59"/>
            <g fill="#fbf7f0"><ellipse cx="20" cy="22" rx="5" ry="6.5"/><ellipse cx="32" cy="18" rx="5" ry="7"/><ellipse cx="44" cy="22" rx="5" ry="6.5"/><ellipse cx="50" cy="33" rx="4.5" ry="5.5"/><ellipse cx="14" cy="33" rx="4.5" ry="5.5"/><path d="M32 32c-9 0-16 6-16 13 0 5 4 8 9 8 3 0 5-1 7-1s4 1 7 1c5 0 9-3 9-8 0-7-7-13-16-13z"/></g>
        </svg>
    </div>
</section>

<div class="mf-inicio-grid" style="margin-top:1.5rem;">
    <article class="mf-card mf-card--clickable">
        <span class="mf-badge">Pacientes</span>
        <h2 class="mf-card-titulo" style="margin-top:.5rem;">Mascotas</h2>
        <p class="mf-card-texto">Consulta el perfil de cada paciente y su línea de tiempo de visitas.</p>
        <a class="btn btn-primary mf-btn-tactil" asp-page="/Mascotas/ListaMascotas">Ver mascotas</a>
    </article>
    <article class="mf-card mf-card--clickable">
        <span class="mf-badge mf-badge--terracota">Tutores</span>
        <h2 class="mf-card-titulo" style="margin-top:.5rem;">Dueños</h2>
        <p class="mf-card-texto">Gestiona los datos de contacto de los responsables de las mascotas.</p>
        <a class="btn btn-outline-primary mf-btn-tactil" asp-page="/Duenos/ListaDuenos">Ver dueños</a>
    </article>
    <article class="mf-card mf-card--clickable">
        <span class="mf-badge mf-badge--gris">Equipo</span>
        <h2 class="mf-card-titulo" style="margin-top:.5rem;">Veterinarios</h2>
        <p class="mf-card-texto">Administra el personal veterinario y sus tarjetas profesionales.</p>
        <a class="btn btn-outline-primary mf-btn-tactil" asp-page="/Veterinarios/ListaVeterinarios">Ver veterinarios</a>
    </article>
</div>
