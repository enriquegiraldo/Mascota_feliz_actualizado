@{
    ViewData["EsPublico"] = true;
}
<!DOCTYPE html>
<html lang="es-CO" data-bs-theme="auto">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d7a5f" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1f1a" media="(prefers-color-scheme: dark)" />
    <meta name="description" content="@(ViewData["MetaDescripcion"] ?? "Clínica veterinaria Mascota Feliz en Bogotá. Atención profesional, citas online y cuidado integral para tu mascota.")" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mascota Feliz" />
    <meta property="og:title" content="@(ViewData["Title"]) · Mascota Feliz" />
    <meta property="og:description" content="@(ViewData["MetaDescripcion"] ?? "Clínica veterinaria Mascota Feliz en Bogotá. Atención profesional, citas online y cuidado integral para tu mascota.")" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content="~/img/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"]) · Mascota Feliz" />
    <link rel="canonical" href="@(Context.Request.Path)" />
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <title>@ViewData["Title"] · Mascota Feliz</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="mf-app">
    <a href="#contenido-principal" class="mf-skip-link">Saltar al contenido</a>
    <header>
        <nav class="navbar navbar-expand-md mf-navbar" aria-label="Navegación principal">
            <div class="container mf-contenedor">
                <a class="navbar-brand mf-marca" asp-page="/Publico/Portada">
                    <img src="~/img/logo.svg" alt="" class="mf-logo" aria-hidden="true" />
                    <span class="mf-marca-nombre">Mascota Feliz</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Abrir menú de navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex flex-md-row-reverse">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Publico/Portada">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Publico/Portada#servicios">Servicios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Publico/Portada#equipo">Equipo</a>
                        </li>
                        <li class="nav-item ms-auto">
                            <a class="btn btn-ghost mf-btn-tactil" asp-page="/Cuenta/Login">Panel interno</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary mf-btn-tactil" asp-page="/Publico/Agendar">Agendar cita</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" id="contenido-principal" class="mf-seccion-publico">
        @RenderBody()
    </main>

    <footer class="mf-footer">
        <div class="mf-contenedor mf-footer-contenido">
            <div>
                <span class="mf-footer-marca">
                    <img src="~/img/logo.svg" alt="" width="24" height="24" aria-hidden="true" />
                    Mascota Feliz · Clínica veterinaria
                </span>
                <p style="margin-top:.5rem;font-size:.85rem;opacity:.7;">
                    Bogotá, Colombia<br />
                    Carrera 15 # 20-30 · Tel: +57 320 888 9900<br />
                    Lun–Vie 8:00–18:00 · Sáb 8:00–14:00
                </p>
            </div>
            <div style="display:flex;flex-direction:column;gap:.4rem;align-items:flex-end;">
                <a asp-page="/Publico/Portada">Inicio</a>
                <a asp-page="/Publico/Agendar">Agendar cita</a>
                <a asp-page="/Privacy">Política de privacidad</a>
                <span>&copy; @DateTime.Now.Year · Mascota Feliz</span>
            </div>
        </div>
    </footer>
</div>

<!-- Botón flotante de WhatsApp -->
<a href="https://wa.me/573208889900?text=Hola%2C%20quiero%20información%20sobre%20citas%20en%20Mascota%20Feliz"
   class="mf-whatsapp-float"
   target="_blank"
   rel="noopener noreferrer"
   aria-label="Contáctanos por WhatsApp">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/>
    </svg>
</a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var mq = window.matchMedia("(prefers-color-scheme: dark)");
            function aplicar(e) { document.documentElement.setAttribute("data-bs-theme", e.matches ? "dark" : "light"); }
            aplicar(mq);
            if (mq.addEventListener) { mq.addEventListener("change", aplicar); } else { mq.addListener(aplicar); }
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
