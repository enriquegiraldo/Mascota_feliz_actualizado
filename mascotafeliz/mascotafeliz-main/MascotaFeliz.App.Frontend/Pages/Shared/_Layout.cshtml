<!DOCTYPE html>
<html lang="es-CO" data-bs-theme="auto">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d7a5f" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1f1a" media="(prefers-color-scheme: dark)" />
    <meta name="description" content="@(ViewData["MetaDescripcion"] ?? "Clínica veterinaria Mascota Feliz: gestión de mascotas, dueños, veterinarios e historias clínicas.")" />
    <meta name="author" content="Clínica Veterinaria Mascota Feliz" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mascota Feliz" />
    <meta property="og:title" content="@(ViewData["Title"]) · Mascota Feliz" />
    <meta property="og:description" content="@(ViewData["MetaDescripcion"] ?? "Clínica veterinaria Mascota Feliz: gestión de mascotas, dueños, veterinarios e historias clínicas.")" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content="~/img/logo.svg" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@(ViewData["Title"]) · Mascota Feliz" />
    <meta name="twitter:description" content="@(ViewData["MetaDescripcion"] ?? "Clínica veterinaria Mascota Feliz: gestión de mascotas, dueños, veterinarios e historias clínicas.")" />
    <link rel="canonical" href="@(Context.Request.Path)" />
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <title>@ViewData["Title"] · Mascota Feliz</title>
    <!-- Bootstrap 5.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Tipografías libres: Inter (UI) + Fraunces (titulares) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="mf-app">
    <a href="#contenido-principal" class="mf-skip-link">Saltar al contenido</a>
    <header>
        <nav class="navbar navbar-expand-md mf-navbar" aria-label="Navegación principal">
            <div class="container mf-contenedor">
                <a class="navbar-brand mf-marca" asp-area="" asp-page="/Index">
                    <img src="~/img/logo.svg" alt="" class="mf-logo" aria-hidden="true" />
                    <span class="mf-marca-nombre">Mascota Feliz</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Abrir menú de navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex flex-md-row-reverse">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Mascotas/ListaMascotas">Mascotas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Duenos/ListaDuenos">Dueños</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Veterinarios/ListaVeterinarios">Veterinarios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Historias/ListaHistorias">Historias</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/VisitasPyP/ListaVisitasPyP">Visitas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Citas/ListaCitas">Citas</a>
                        </li>
                        <li class="nav-item ms-auto mf-nav-buscar-item">
                            <button type="button" class="mf-nav-buscar" id="mf-abrir-cmdk" aria-label="Buscar (Ctrl+K)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                <span class="mf-nav-buscar-texto">Buscar…</span>
                                <kbd class="mf-nav-buscar-kbd">Ctrl K</kbd>
                            </button>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item mf-nav-usuario-item">
                                <div class="mf-nav-usuario">
                                    <span class="mf-nav-usuario-nombre">@User.Identity.Name</span>
                                    <form method="post" asp-page="/Cuenta/Logout" style="display:inline;">
                                        <button type="submit" class="btn btn-ghost btn-sm mf-btn-logout" title="Cerrar sesión" aria-label="Cerrar sesión">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" id="contenido-principal" class="mf-seccion">
        <div class="mf-contenedor">
            @RenderBody()
        </div>
    </main>

    <footer class="mf-footer">
        <div class="mf-contenedor mf-footer-contenido">
            <span class="mf-footer-marca">
                <img src="~/img/logo.svg" alt="" width="24" height="24" aria-hidden="true" />
                Mascota Feliz · Clínica veterinaria
            </span>
            <span>&copy; @DateTime.Now.Year · Hecho con cariño para quienes cuidan mascotas.</span>
        </div>
    </footer>
</div>

<partial name="_CommandPalette" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/command-palette.js" asp-append-version="true"></script>
    <script>
        // data-bs-theme="auto": sincroniza con prefers-color-scheme.
        (function () {
            var mq = window.matchMedia("(prefers-color-scheme: dark)");
            function aplicar(e) {
                document.documentElement.setAttribute("data-bs-theme", e.matches ? "dark" : "light");
            }
            aplicar(mq);
            if (mq.addEventListener) { mq.addEventListener("change", aplicar); }
            else { mq.addListener(aplicar); }
        })();
    </script>
    @if (TempData["Mensaje"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (window.MascotaFeliz && window.MascotaFeliz.mostrarToast) {
                    window.MascotaFeliz.mostrarToast(@Json.Serialize(TempData["Mensaje"]));
                }
            });
        </script>
    }

    @RenderSection("Scripts", required: false)
</body>
</html>
