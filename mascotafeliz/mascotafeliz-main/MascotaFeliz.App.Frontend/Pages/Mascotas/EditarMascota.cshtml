@page
@model MascotaFeliz.App.Frontend.Pages.EditarMascotaModel
@{
    ViewData["Title"] = Model.mascota.Id > 0 ? "Editar mascota" : "Nueva mascota";
}

<div class="mf-encabezado">
    <div>
        <h1>@(Model.mascota.Id > 0 ? "Editar mascota" : "Nueva mascota")</h1>
        <p class="mf-muted">Datos del paciente y sus vínculos clínicos.</p>
    </div>
    <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaMascotas">← Volver</a>
</div>

<form method="post" class="mf-ficha mf-form">
    <input type="hidden" asp-for="mascota.Id" />
    <input type="hidden" asp-for="mascota.FotoUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label>Foto de la mascota</label>
        <div class="mf-foto-upload">
            <div class="mf-foto-preview" id="fotoPreview">
                else
                {
                    <span class="mf-foto-placeholder" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5"/>
                            <polyline points="21 15 16 10 5 21"/>
                        </svg>
                    </span>
                }
            </div>
            <div class="mf-foto-controles">
                <input name="Foto" id="Foto" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
                <small class="mf-muted">JPG, PNG o WebP · máx. 2 MB</small>
                <span asp-validation-for="Foto" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="mascota.Nombre"></label>
        <input asp-for="mascota.Nombre" class="form-control" />
        <span asp-validation-for="mascota.Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="mascota.Especie"></label>
        <input asp-for="mascota.Especie" class="form-control" placeholder="Perro, Gato, Conejo…" />
        <span asp-validation-for="mascota.Especie" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="mascota.Raza"></label>
        <input asp-for="mascota.Raza" class="form-control" placeholder="Labrador, Siamés…" />
        <span asp-validation-for="mascota.Raza" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="mascota.Color"></label>
        <input asp-for="mascota.Color" class="form-control" placeholder="Café, Blanco, Negro…" />
        <span asp-validation-for="mascota.Color" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="mascota.DuenoId">Dueño</label>
        <select asp-for="mascota.DuenoId" class="form-select" asp-items="Model.DuenosOpciones">
            <option value="">— Sin dueño asignado —</option>
        </select>
        <span asp-validation-for="mascota.DuenoId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="mascota.VeterinarioId">Veterinario</label>
        <select asp-for="mascota.VeterinarioId" class="form-select" asp-items="Model.VeterinariosOpciones">
            <option value="">— Sin veterinario asignado —</option>
        </select>
        <span asp-validation-for="mascota.VeterinarioId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="mascota.HistoriaId">Historia clínica</label>
        <select asp-for="mascota.HistoriaId" class="form-select" asp-items="Model.HistoriasOpciones">
            <option value="">— Sin historia asignada —</option>
        </select>
        <span asp-validation-for="mascota.HistoriaId" class="text-danger"></span>
        <small class="mf-avance">Si no existe, primero créala en la sección Historias.</small>
    </div>

    <div class="mf-tabla-acciones" style="margin-top:1rem;">
        <button type="submit" class="btn btn-primary mf-btn-tactil">Guardar</button>
        <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaMascotas">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelector("form.mf-form").setAttribute("enctype", "multipart/form-data");
            var input = document.getElementById("Foto");
            var preview = document.getElementById("fotoPreview");
            if (!input || !preview) return;
            input.addEventListener("change", function (e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (ev) {
                        preview.innerHTML = '<img src="' + ev.target.result + '" alt="Vista previa" />';
                    };
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
}
