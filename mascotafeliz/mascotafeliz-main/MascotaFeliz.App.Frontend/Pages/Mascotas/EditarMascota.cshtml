@page
@model MascotaFeliz.App.Frontend.Pages.EditarMascotaModel
@{
    ViewData["Title"] = Model.mascota.Id > 0 ? "Editar mascota" : "Nueva mascota";
}

<div class="mf-encabezado">
    <div>
        <h1>@(Model.mascota.Id > 0 ? "Editar mascota" : "Nueva mascota")</h1>
        <p class="mf-muted">Datos del paciente y sus vínculos clínicos.</p>
    </div>
    <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaMascotas">← Volver</a>
</div>

<form method="post" class="mf-ficha mf-form">
    <input type="hidden" asp-for="mascota.Id" />
    <input type="hidden" asp-for="mascota.HistoriaId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="mascota.Nombre"></label>
        <input asp-for="mascota.Nombre" class="form-control" />
        <span asp-validation-for="mascota.Nombre" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="mascota.Especie"></label>
        <input asp-for="mascota.Especie" class="form-control" placeholder="Perro, Gato, Conejo…" />
        <span asp-validation-for="mascota.Especie" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="mascota.Raza"></label>
        <input asp-for="mascota.Raza" class="form-control" placeholder="Labrador, Siamés…" />
        <span asp-validation-for="mascota.Raza" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="mascota.Color"></label>
        <input asp-for="mascota.Color" class="form-control" placeholder="Café, Blanco, Negro…" />
        <span asp-validation-for="mascota.Color" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="mascota.DuenoId">Dueño</label>
        <select asp-for="mascota.DuenoId" class="form-control" asp-items="Model.DuenosOpciones">
            <option value="">— Sin dueño asignado —</option>
        </select>
        <span asp-validation-for="mascota.DuenoId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="mascota.VeterinarioId">Veterinario</label>
        <select asp-for="mascota.VeterinarioId" class="form-control" asp-items="Model.VeterinariosOpciones">
            <option value="">— Sin veterinario asignado —</option>
        </select>
        <span asp-validation-for="mascota.VeterinarioId" class="text-danger"></span>
    </div>

    @if (Model.mascota.HistoriaId.HasValue)
    {
        <p class="mf-avance">Esta mascota tiene una historia clínica asociada ( #@Model.mascota.HistoriaId ).</p>
    }
    else
    {
        <p class="mf-avance">Esta mascota aún no tiene historia clínica. Se podrá crear desde su perfil.</p>
    }

    <div class="mf-tabla-acciones" style="margin-top:1rem;">
        <button type="submit" class="btn btn-primary mf-btn-tactil">Guardar</button>
        <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaMascotas">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
