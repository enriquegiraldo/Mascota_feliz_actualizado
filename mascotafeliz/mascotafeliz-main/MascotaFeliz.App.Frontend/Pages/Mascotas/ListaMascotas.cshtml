@page
@model MascotaFeliz.App.Frontend.Pages.ListaMascotasModel
@{
    ViewData["Title"] = "Mascotas";
}

<div class="mf-encabezado">
    <div>
        <h1>Mascotas</h1>
        <p class="mf-muted">Pacientes registrados en la clínica.</p>
    </div>
    <div class="mf-acciones">
        <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaMascotas" asp-page-handler="ExportarCsv" asp-route-q="@Model.Q" asp-route-especie="@Model.Especie" aria-label="Exportar a CSV">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            CSV
        </a>
        <a class="btn btn-primary mf-btn-tactil" asp-page="./EditarMascota">+ Nueva mascota</a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="mf-aviso" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@TempData["Error"]</span>
    </div>
}

<form method="get" class="mf-buscador" role="search">
    <div class="mf-input-busqueda">
        <span class="mf-ico-lupa" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
        <input type="search" name="Q" value="@Model.Q" placeholder="Buscar por nombre, especie o raza…" aria-label="Buscar mascotas" />
    </div>
    <button type="submit" class="btn btn-outline-primary mf-btn-tactil">Buscar</button>
    <input type="hidden" name="Especie" value="@Model.Especie" />
    @if (!string.IsNullOrWhiteSpace(Model.Q) || !string.IsNullOrWhiteSpace(Model.Especie))
    {
        <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaMascotas">Limpiar</a>
    }
</form>

@if (Model.Especies.Any())
{
    <div class="mf-chips" role="group" aria-label="Filtrar por especie">
        <a class="mf-chip @(string.IsNullOrWhiteSpace(Model.Especie) ? "mf-chip--activo" : "")"
           asp-page="./ListaMascotas" asp-route-Q="@Model.Q">Todas</a>
        @foreach (var esp in Model.Especies)
        {
            <a class="mf-chip @(Model.Especie == esp ? "mf-chip--activo" : "")"
               asp-page="./ListaMascotas" asp-route-Q="@Model.Q" asp-route-Especie="@esp">@esp</a>
        }
    </div>
}

@if (!Model.listaMascotas.Any())
{
    <div class="mf-vacio">
        <svg class="mf-vacio-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="#6b7280" stroke-width="2"><ellipse cx="20" cy="22" rx="5" ry="6.5"/><ellipse cx="32" cy="18" rx="5" ry="7"/><ellipse cx="44" cy="22" rx="5" ry="6.5"/><ellipse cx="50" cy="33" rx="4.5" ry="5.5"/><ellipse cx="14" cy="33" rx="4.5" ry="5.5"/><path d="M32 32c-9 0-16 6-16 13 0 5 4 8 9 8 3 0 5-1 7-1s4 1 7 1c5 0 9-3 9-8 0-7-7-13-16-13z"/></svg>
        <p>No hay mascotas que coincidan con la búsqueda.</p>
        <a class="btn btn-primary mf-btn-tactil" asp-page="./EditarMascota">Registrar la primera mascota</a>
    </div>
}
else
{
    <div style="overflow-x:auto;">
    <table class="mf-tabla">
        <thead>
            <tr>
                <th class="mf-th-ordenable">
                    <a asp-page="./ListaMascotas" asp-route-Q="@Model.Q" asp-route-Especie="@Model.Especie" asp-route-Orden="@(Model.Orden == "nombre-desc" ? "" : "nombre-desc")" class="mf-th-link">
                        Nombre <span class="mf-th-flecha" aria-hidden="true">@(Model.Orden == "nombre-desc" ? "▼" : (Model.Orden == "" || string.IsNullOrEmpty(Model.Orden)) ? "▲" : "")</span>
                    </a>
                </th>
                <th class="mf-th-ordenable">
                    <a asp-page="./ListaMascotas" asp-route-Q="@Model.Q" asp-route-Especie="@Model.Especie" asp-route-Orden="@(Model.Orden == "especie-desc" ? "especie" : "especie-desc")" class="mf-th-link">
                        Especie <span class="mf-th-flecha" aria-hidden="true">@(Model.Orden == "especie-desc" ? "▼" : Model.Orden == "especie" ? "▲" : "")</span>
                    </a>
                </th>
                <th class="mf-th-ordenable">
                    <a asp-page="./ListaMascotas" asp-route-Q="@Model.Q" asp-route-Especie="@Model.Especie" asp-route-Orden="@(Model.Orden == "raza-desc" ? "raza" : "raza-desc")" class="mf-th-link">
                        Raza <span class="mf-th-flecha" aria-hidden="true">@(Model.Orden == "raza-desc" ? "▼" : Model.Orden == "raza" ? "▲" : "")</span>
                    </a>
                </th>
                <th>Dueño</th>
                <th>Veterinario</th>
                <th><span class="mf-sr-only">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var mascota in Model.listaMascotas)
        {
            <tr>
                <td>
                    <strong>@mascota.Nombre</strong>
                    <div class="mf-muted" style="font-size:.8rem;">@mascota.Color · #@mascota.Id</div>
                </td>
                <td><span class="mf-badge">@mascota.Especie</span></td>
                <td>@mascota.Raza</td>
                <td>@(mascota.Dueno != null ? $"{mascota.Dueno.Nombres} {mascota.Dueno.Apellidos}" : "—")</td>
                <td>@(mascota.Veterinario != null ? $"{mascota.Veterinario.Nombres} {mascota.Veterinario.Apellidos}" : "—")</td>
                <td>
                    <div class="mf-tabla-acciones">
                        <a class="btn btn-ghost mf-btn-tactil" asp-page="./DetallesMascotas" asp-route-mascotaId="@mascota.Id">Detalle</a>
                        <a class="btn btn-outline-primary mf-btn-tactil" asp-page="./EditarMascota" asp-route-mascotaId="@mascota.Id">Editar</a>
                        <form method="post" asp-page-handler="Eliminar" asp-route-mascotaId="@mascota.Id"
                              data-mf-borrar="true" data-nombre="la mascota @mascota.Nombre">
                            <button type="submit" class="btn btn-danger mf-btn-tactil" aria-label="Eliminar mascota">Eliminar</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>

    <nav class="mf-paginacion" aria-label="Paginación" style="justify-content:space-between;">
        <span class="mf-muted" style="border:none;background:none;">@Model.Total registro(s) · pág. @Model.Pagina de @Model.TotalPaginas</span>
        <span style="display:flex;gap:.35rem;">
            @if (Model.Pagina > 1)
            {
                <a asp-page="./ListaMascotas" asp-route-Q="@Model.Q" asp-route-Especie="@Model.Especie" asp-route-Orden="@Model.Orden" asp-route-Pagina="@(Model.Pagina - 1)">‹ Anterior</a>
            }
            else
            {
                <span class="mf-deshab">‹ Anterior</span>
            }
            @if (Model.Pagina < Model.TotalPaginas)
            {
                <a asp-page="./ListaMascotas" asp-route-Q="@Model.Q" asp-route-Especie="@Model.Especie" asp-route-Orden="@Model.Orden" asp-route-Pagina="@(Model.Pagina + 1)">Siguiente ›</a>
            }
            else
            {
                <span class="mf-deshab">Siguiente ›</span>
            }
        </span>
    </nav>
}
