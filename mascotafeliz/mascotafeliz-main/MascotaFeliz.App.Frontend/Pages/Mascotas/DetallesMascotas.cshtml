@page
@model MascotaFeliz.App.Frontend.Pages.DetallesMascotasModel
@{
    ViewData["Title"] = Model.mascota.Nombre;
    var visitasDesc = Model.mascota.Historia?.VisitasPyP?
        .OrderByDescending(v => v.FechaVisita).ToList();
    var cultura = new System.Globalization.CultureInfo("es-CO");

    // Datos para el gráfico de peso (ordenados ascendentemente por fecha).
    var visitasPeso = Model.mascota.Historia?.VisitasPyP?
        .OrderBy(v => v.FechaVisita).ToList() ?? new List<MascotaFeliz.App.Dominio.VisitaPyP>();
    var hayPeso = visitasPeso.Any();
    double w = 320, h = 120, pad = 28;
    var pesos = hayPeso ? visitasPeso.Select(v => (double)v.Peso).ToList() : new List<double>();
    var minP = hayPeso ? pesos.Min() : 0; var maxP = hayPeso ? pesos.Max() : 1;
    var rango = Math.Max(maxP - minP, 0.1);
    var minPv = minP - rango * 0.15; var maxPv = maxP + rango * 0.15;
    System.Func<double, double> x = i => pad + (hayPeso ? i / Math.Max(visitasPeso.Count - 1, 1) * (w - 2 * pad) : 0);
    System.Func<double, double> y = pv => h - pad - (pv - minPv) / (maxPv - minPv) * (h - 2 * pad);
    var puntos = visitasPeso.Select((v, i) => (X: x(i), Y: y((double)v.Peso), V: v)).ToList();
    var path = hayPeso && visitasPeso.Count > 1
        ? "M " + string.Join(" L ", puntos.Select(p => $"{p.X:F1},{p.Y:F1}"))
        : "";
    var area = hayPeso && visitasPeso.Count > 1
        ? path + $" L {x(visitasPeso.Count - 1):F1},{h - pad:F1} L {x(0):F1},{h - pad:F1} Z"
        : "";
}

<nav aria-label="Migas de pan" class="mf-migas">
    <a asp-page="/Mascotas/ListaMascotas">Mascotas</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">@Model.mascota.Nombre</span>
</nav>

<section class="mf-ficha mf-hero-mascota" style="background:linear-gradient(135deg,var(--mf-verde-claro2) 0%,var(--mf-arena) 100%);">
    <div class="mf-hero-mascota-contenido">
        @if (!string.IsNullOrEmpty(Model.mascota.FotoUrl))
        {
            <img src="@Model.mascota.FotoUrl" alt="Foto de @Model.mascota.Nombre" class="mf-foto-avatar-grande" />
        }
        else
        {
            <span class="mf-hero-avatar mf-hero-avatar--@(Model.mascota.Especie == "Gato" ? "gato" : "perro")" aria-hidden="true">
                @if (Model.mascota.Especie == "Gato")
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M12 8C8 8 6 11 6 14v6h12v-6c0-3-2-6-6-6zM6 4l3 4-2 1-3-3zM18 4l2 2-3 3-2-1z"/></svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M4 10c0-3 2-5 5-5 1 0 2 1 3 1s2-1 3-1c3 0 5 2 5 5v3h-3v6H7v-6H4z"/></svg>
                }
            </span>
        }
        <div>
            <span class="mf-badge">@(Model.mascota.Especie ?? "Mascota") · @Model.mascota.Raza</span>
            <h1 style="margin-top:.4rem;">@Model.mascota.Nombre</h1>
            <p class="mf-muted">Perfil del paciente · #@Model.mascota.Id · Color: @Model.mascota.Color</p>
        </div>
    </div>
    <div class="mf-acciones mf-no-print">
        @if (Model.mascota.HistoriaId.HasValue)
        {
            <a class="btn btn-primary mf-btn-tactil" asp-page="/VisitasPyP/EditarVisitaPyP" asp-route-historiaId="@Model.mascota.HistoriaId">+ Agregar visita</a>
        }
        <button type="button" class="btn btn-ghost mf-btn-tactil" onclick="window.print()" aria-label="Imprimir ficha de la mascota">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Imprimir
        </button>
        <a class="btn btn-outline-primary mf-btn-tactil mf-no-print" asp-page="./EditarMascota" asp-route-mascotaId="@Model.mascota.Id">Editar</a>
        <a class="btn btn-ghost mf-btn-tactil mf-no-print" asp-page="./ListaMascotas">← Volver</a>
    </div>
</section>

<div class="mf-ficha">
    <div class="mf-ficha-titulo">
        <svg class="mf-ficha-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <h2 style="margin:0;">Datos de la mascota</h2>
    </div>
    <dl>
        <div class="mf-fila"><dt>Nombre</dt><dd>@Model.mascota.Nombre</dd></div>
        <div class="mf-fila"><dt>Especie</dt><dd>@Model.mascota.Especie</dd></div>
        <div class="mf-fila"><dt>Raza</dt><dd>@Model.mascota.Raza</dd></div>
        <div class="mf-fila"><dt>Color</dt><dd>@Model.mascota.Color</dd></div>
    </dl>
</div>

<div class="mf-ficha">
    <div class="mf-ficha-titulo">
        <svg class="mf-ficha-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <h2 style="margin:0;">Dueño y veterinario</h2>
    </div>
    <dl>
        <div class="mf-fila">
            <dt>Dueño</dt>
            <dd>
                @if (Model.mascota.Dueno != null)
                {
                    <a asp-page="/Duenos/DetallesDuenos" asp-route-duenoId="@Model.mascota.Dueno.Id">@Model.mascota.Dueno.Nombres @Model.mascota.Dueno.Apellidos</a>
                }
                else { <span class="mf-muted">Sin dueño asignado</span> }
            </dd>
        </div>
        <div class="mf-fila">
            <dt>Veterinario</dt>
            <dd>
                @if (Model.mascota.Veterinario != null)
                {
                    <a asp-page="/Veterinarios/DetallesVeterinarios" asp-route-veterinarioId="@Model.mascota.Veterinario.Id">@Model.mascota.Veterinario.Nombres @Model.mascota.Veterinario.Apellidos</a>
                }
                else { <span class="mf-muted">Sin veterinario asignado</span> }
            </dd>
        </div>
    </dl>
</div>

<div class="mf-ficha">
    <div class="mf-ficha-titulo">
        <svg class="mf-ficha-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
        <h2 style="margin:0;">Historia clínica</h2>
    </div>

    @if (Model.mascota.Historia == null)
    {
        <p class="mf-muted">Esta mascota aún no tiene historia clínica.</p>
    }
    else
    {
        <dl>
            <div class="mf-fila"><dt>Historia N.°</dt><dd>#@Model.mascota.Historia.Id</dd></div>
            <div class="mf-fila"><dt>Fecha inicial</dt><dd>@Model.mascota.Historia.FechaInicial.ToString("d 'de' MMMM 'de' yyyy", cultura)</dd></div>
            <div class="mf-fila"><dt>Visitas registradas</dt><dd>@(Model.mascota.Historia.VisitasPyP?.Count ?? 0)</dd></div>
        </dl>

        @if (hayPeso)
        {
            <div class="mf-grafico">
                <div class="mf-grafico-titulo">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><polyline points="7 14 12 9 16 13 21 6"/></svg>
                    <span>Evolución del peso (kg)</span>
                </div>
                <svg class="mf-grafico-svg" viewBox="0 0 @w @h" role="img" aria-label="Gráfico de evolución del peso">
                    <line x1="@pad" y1="@(h-pad)" x2="@(w-pad)" y2="@(h-pad)" stroke="var(--mf-gris-claro)" stroke-width="1"/>
                    <line x1="@pad" y1="@pad" x2="@pad" y2="@(h-pad)" stroke="var(--mf-gris-claro)" stroke-width="1"/>
                    @if (hayPeso && visitasPeso.Count > 1)
                    {
                        <path d="@area" fill="rgba(74,124,89,.14)" stroke="none"/>
                        <path d="@path" fill="none" stroke="var(--mf-verde)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    }
                    @foreach (var p in puntos)
                    {
                        <circle cx="@p.X" cy="@p.Y" r="4" fill="var(--mf-verde)" stroke="var(--mf-blanco)" stroke-width="1.5" />
                        @:<text x="@p.X" y="@(p.Y - 9)" text-anchor="middle" font-size="9" fill="var(--mf-gris)" font-weight="600">@p.V.Peso.ToString("0.0", cultura)</text>
                        @:<text x="@p.X" y="@(h - pad + 14)" text-anchor="middle" font-size="8" fill="var(--mf-gris)">@p.V.FechaVisita.ToString("dd/MM/yy", cultura)</text>
                    }
                </svg>
                @if (visitasPeso.Count < 2)
                {
                    <p class="mf-muted" style="font-size:.82rem;margin-top:.4rem;">Se necesitan al menos dos visitas para ver la tendencia.</p>
                }
            </div>
        }

        <div class="mf-tabla-acciones" style="margin:.5rem 0 1.25rem;">
            <a class="btn btn-ghost mf-btn-tactil" asp-page="/Historias/DetallesHistoria" asp-route-historiaId="@Model.mascota.Historia.Id">Ver historia completa</a>
            <a class="btn btn-primary mf-btn-tactil" asp-page="/VisitasPyP/EditarVisitaPyP" asp-route-historiaId="@Model.mascota.Historia.Id">+ Agregar visita</a>
        </div>

        <h3 style="margin-top:1.5rem;font-size:1.1rem;">Línea de tiempo de visitas PyP</h3>
        @if (visitasDesc == null || !visitasDesc.Any())
        {
            <div class="mf-vacio" style="padding:1.5rem 1rem;">
                <p>Aún no se han registrado visitas de promoción y prevención.</p>
                <a class="btn btn-primary mf-btn-tactil" asp-page="/VisitasPyP/EditarVisitaPyP" asp-route-historiaId="@Model.mascota.Historia.Id">Registrar la primera visita</a>
            </div>
        }
        else
        {
            <div class="mf-timeline">
            @foreach (var v in visitasDesc)
            {
                <div class="mf-timeline-item mf-card" style="padding:1rem;">
                    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:.5rem;align-items:baseline;">
                        <strong>@v.FechaVisita.ToString("d 'de' MMMM 'de' yyyy", cultura)</strong>
                        <span class="mf-badge mf-badge--ambar">#@v.Id</span>
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:.5rem 1rem;margin-top:.6rem;">
                        <span class="mf-muted" style="font-size:.82rem;">Temperatura</span><span>@v.Temperatura.ToString("0.0", cultura) °C</span>
                        <span class="mf-muted" style="font-size:.82rem;">Peso</span><span>@v.Peso.ToString("0.0", cultura) kg</span>
                        <span class="mf-muted" style="font-size:.82rem;">F. respiratoria</span><span>@v.FrecuenciaRespiratoria.ToString("0", cultura) /min</span>
                        <span class="mf-muted" style="font-size:.82rem;">F. cardiaca</span><span>@v.FrecuenciaCardiaca.ToString("0", cultura) /min</span>
                        <span class="mf-muted" style="font-size:.82rem;">Estado de ánimo</span><span>@(string.IsNullOrWhiteSpace(v.EstadoAnimo) ? "—" : v.EstadoAnimo)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(v.Recomendaciones))
                    {
                        <p style="margin-top:.6rem;padding-top:.6rem;border-top:1px solid var(--mf-arena);">
                            <span class="mf-muted" style="font-size:.82rem;">Recomendaciones: </span>@v.Recomendaciones
                        </p>
                    }
                    <div class="mf-tabla-acciones" style="margin-top:.5rem;">
                        <a class="btn btn-ghost mf-btn-tactil" asp-page="/VisitasPyP/DetallesVisitaPyP" asp-route-visitaPyPId="@v.Id">Ver detalle</a>
                    </div>
                </div>
            }
            </div>
        }
    }
</div>
