@page
@model MascotaFeliz.App.Frontend.Pages.ListaVisitasPyPModel
@{
    ViewData["Title"] = "Visitas PyP";
    var cultura = new System.Globalization.CultureInfo("es-CO");
}

<div class="mf-encabezado">
    <div>
        <h1>Visitas de PyP</h1>
        <p class="mf-muted">Consultas de promoción y prevención registradas.</p>
    </div>
    <div class="mf-acciones">
        <a class="btn btn-primary mf-btn-tactil" asp-page="./EditarVisitaPyP">+ Nueva visita</a>
    </div>
</div>

<form method="get" class="mf-buscador" role="search">
    <div class="mf-input-busqueda">
        <span class="mf-ico-lupa" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
        <input type="search" name="Q" value="@Model.Q" placeholder="Buscar por fecha, estado de ánimo o recomendación…" aria-label="Buscar visitas" />
    </div>
    <button type="submit" class="btn btn-outline-primary mf-btn-tactil">Buscar</button>
    @if (!string.IsNullOrWhiteSpace(Model.Q))
    {
        <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaVisitasPyP">Limpiar</a>
    }
</form>

@if (!Model.listaVisitasPyP.Any())
{
    <div class="mf-vacio">
        <svg class="mf-vacio-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <p>No hay visitas que coincidan con la búsqueda.</p>
        <a class="btn btn-primary mf-btn-tactil" asp-page="./EditarVisitaPyP">Registrar la primera visita</a>
    </div>
}
else
{
    <div style="overflow-x:auto;">
    <table class="mf-tabla">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Historia</th>
                <th>Signos vitales</th>
                <th>Estado de ánimo</th>
                <th><span class="mf-sr-only">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var v in Model.listaVisitasPyP)
        {
            <tr>
                <td><strong>@v.FechaVisita.ToString("d 'de' MMM 'de' yyyy", cultura)</strong></td>
                <td><a asp-page="/Historias/DetallesHistoria" asp-route-historiaId="@v.HistoriaId">#@v.HistoriaId</a></td>
                <td>
                    <span class="mf-muted" style="font-size:.82rem;">Temp/Peso/FR/FC:</span>
                    <span>@v.Temperatura.ToString("0.0", cultura)°C · @v.Peso.ToString("0.0", cultura)kg · @v.FrecuenciaRespiratoria.ToString("0", cultura) · @v.FrecuenciaCardiaca.ToString("0", cultura)</span>
                </td>
                <td>@(string.IsNullOrWhiteSpace(v.EstadoAnimo) ? "—" : v.EstadoAnimo)</td>
                <td>
                    <div class="mf-tabla-acciones">
                        <a class="btn btn-ghost mf-btn-tactil" asp-page="./DetallesVisitaPyP" asp-route-visitaPyPId="@v.Id">Detalle</a>
                        <a class="btn btn-outline-primary mf-btn-tactil" asp-page="./EditarVisitaPyP" asp-route-visitaPyPId="@v.Id">Editar</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>

    <nav class="mf-paginacion" aria-label="Paginación" style="justify-content:space-between;">
        <span class="mf-muted" style="border:none;background:none;">@Model.Total registro(s) · pág. @Model.Pagina de @Model.TotalPaginas</span>
        <span style="display:flex;gap:.35rem;">
            @if (Model.Pagina > 1)
            {
                <a asp-page="./ListaVisitasPyP" asp-route-Q="@Model.Q" asp-route-Pagina="@(Model.Pagina - 1)">‹ Anterior</a>
            }
            else
            {
                <span class="mf-deshab">‹ Anterior</span>
            }
            @if (Model.Pagina < Model.TotalPaginas)
            {
                <a asp-page="./ListaVisitasPyP" asp-route-Q="@Model.Q" asp-route-Pagina="@(Model.Pagina + 1)">Siguiente ›</a>
            }
            else
            {
                <span class="mf-deshab">Siguiente ›</span>
            }
        </span>
    </nav>
}
