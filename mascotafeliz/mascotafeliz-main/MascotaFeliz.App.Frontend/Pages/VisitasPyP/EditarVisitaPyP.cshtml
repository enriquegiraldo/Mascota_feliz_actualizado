@page
@model MascotaFeliz.App.Frontend.Pages.EditarVisitaPyPModel
@{
    ViewData["Title"] = Model.visitaPyP.Id > 0 ? "Editar visita" : "Nueva visita";
    var cultura = new System.Globalization.CultureInfo("es-CO");
}

<div class="mf-encabezado">
    <div>
        <h1>@(Model.visitaPyP.Id > 0 ? "Editar visita PyP" : "Nueva visita PyP")</h1>
        <p class="mf-muted">Registro de signos vitales y recomendaciones.</p>
    </div>
    <a class="btn btn-ghost mf-btn-tactil" asp-page="/Historias/DetallesHistoria" asp-route-historiaId="@Model.visitaPyP.HistoriaId">← Volver</a>
</div>

<form method="post" class="mf-ficha mf-form">
    <input type="hidden" asp-for="visitaPyP.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="visitaPyP.HistoriaId"></label>
        <select asp-for="visitaPyP.HistoriaId" class="form-control" asp-items="Model.HistoriasOpciones">
            <option value="">— Selecciona una historia clínica —</option>
        </select>
        <span asp-validation-for="visitaPyP.HistoriaId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="visitaPyP.FechaVisita"></label>
        <input asp-for="visitaPyP.FechaVisita" class="form-control" type="date" />
        <span asp-validation-for="visitaPyP.FechaVisita" class="text-danger"></span>
    </div>

    <h3 style="font-size:1rem;margin-top:1.25rem;color:var(--mf-gris);">Signos vitales</h3>
    <div class="mf-grid-2">
        <div class="mb-3">
            <label asp-for="visitaPyP.Temperatura"></label>
            <input asp-for="visitaPyP.Temperatura" class="form-control" inputmode="decimal" placeholder="38,5" />
            <span asp-validation-for="visitaPyP.Temperatura" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="visitaPyP.Peso"></label>
            <input asp-for="visitaPyP.Peso" class="form-control" inputmode="decimal" placeholder="28,0" />
            <span asp-validation-for="visitaPyP.Peso" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="visitaPyP.FrecuenciaRespiratoria"></label>
            <input asp-for="visitaPyP.FrecuenciaRespiratoria" class="form-control" inputmode="numeric" placeholder="22" />
            <span asp-validation-for="visitaPyP.FrecuenciaRespiratoria" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="visitaPyP.FrecuenciaCardiaca"></label>
            <input asp-for="visitaPyP.FrecuenciaCardiaca" class="form-control" inputmode="numeric" placeholder="110" />
            <span asp-validation-for="visitaPyP.FrecuenciaCardiaca" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="visitaPyP.EstadoAnimo"></label>
        <input asp-for="visitaPyP.EstadoAnimo" class="form-control" placeholder="Activo, tranquilo, receloso…" />
        <span asp-validation-for="visitaPyP.EstadoAnimo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="visitaPyP.Recomendaciones"></label>
        <textarea asp-for="visitaPyP.Recomendaciones" class="form-control" rows="3" placeholder="Indicaciones, medicamentos, próximos controles…"></textarea>
        <span asp-validation-for="visitaPyP.Recomendaciones" class="text-danger"></span>
    </div>

    <div class="mf-tabla-acciones" style="margin-top:1rem;">
        <button type="submit" class="btn btn-primary mf-btn-tactil">Guardar visita</button>
        <a class="btn btn-ghost mf-btn-tactil" asp-page="/VisitasPyP/ListaVisitasPyP">Cancelar</a>
    </div>
</form>

@if (Model.visitaPyP.Id > 0)
{
    <form method="post" asp-page-handler="Eliminar" asp-route-visitaPyPId="@Model.visitaPyP.Id"
          data-mf-borrar="true" data-nombre="la visita del @Model.visitaPyP.FechaVisita.ToString("d 'de' MMMM 'de' yyyy", cultura)"
          style="margin-top:1.25rem;">
        <button type="submit" class="btn btn-danger mf-btn-tactil">Eliminar visita</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
