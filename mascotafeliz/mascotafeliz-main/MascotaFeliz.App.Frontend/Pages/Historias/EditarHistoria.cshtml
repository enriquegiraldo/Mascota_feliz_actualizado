@page
@model MascotaFeliz.App.Frontend.Pages.EditarHistoriaModel
@{
    ViewData["Title"] = Model.historia.Id > 0 ? "Editar historia" : "Nueva historia";
    var cultura = new System.Globalization.CultureInfo("es-CO");
}

<div class="mf-encabezado">
    <div>
        <h1>@(Model.historia.Id > 0 ? "Editar historia clínica" : "Nueva historia clínica")</h1>
        <p class="mf-muted">Registro contenedor de las visitas de promoción y prevención.</p>
    </div>
    <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaHistorias">← Volver</a>
</div>

<form method="post" class="mf-ficha mf-form">
    <input type="hidden" asp-for="historia.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="historia.FechaInicial"></label>
        <input asp-for="historia.FechaInicial" class="form-control" type="date" />
        <span asp-validation-for="historia.FechaInicial" class="text-danger"></span>
    </div>

    @if (Model.historia.Id > 0)
    {
        <p class="mf-avance">
            Esta historia ( #@Model.historia.Id ) tiene
            <strong>@(Model.historia.VisitasPyP?.Count ?? 0) visita(s)</strong> registrada(s).
            Puedes agregar visitas desde el detalle de la historia.
        </p>
    }

    <div class="mf-tabla-acciones" style="margin-top:1rem;">
        <button type="submit" class="btn btn-primary mf-btn-tactil">Guardar</button>
        <a class="btn btn-ghost mf-btn-tactil" asp-page="./ListaHistorias">Cancelar</a>
    </div>
</form>

@if (Model.historia.Id > 0)
{
    <form method="post" asp-page-handler="Eliminar" asp-route-historiaId="@Model.historia.Id"
          data-mf-borrar="true" data-nombre="la historia #@Model.historia.Id"
          style="margin-top:1.25rem;">
        <button type="submit" class="btn btn-danger mf-btn-tactil">Eliminar historia</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
